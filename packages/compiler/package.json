{
  "name": "@stream3d/compiler",
  "version": "0.1.0",
  "description": "Compile glTF assets into progressive Stream3D representations",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "stream3d": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@stream3d/core": "0.1.0",
    "draco3dgltf": "1.5.7",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ziyu/stream3d.git",
    "directory": "packages/compiler"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
